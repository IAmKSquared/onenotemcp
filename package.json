{
  "name": "onenote-mcp-server",
  "version": "1.0.0",
  "description": "An MCP server to interact with Microsoft OneNote, allowing LLMs to read, write, and edit notes.",
  "main": "src/server.mjs",
  "type": "module",
  "scripts": {
    "start": "node src/server.mjs",
    "test": "npm run test:unit && npm run test:smoke && npm run test:integration",
    "test:unit": "node --test test/test_unit.mjs",
    "test:smoke": "node test/test_smoke.mjs",
    "test:integration": "node test/test_integration.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,json,md}\"",
    "quality": "npm run lint && npm run format:check && npm test",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eshlon/onenote-mcp-server.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "onenote",
    "microsoft-graph",
    "llm",
    "ai",
    "claude"
  ],
  "author": "Ehsan Shahabi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/[eshlon/onenote-mcp-server/issues"
  },
  "homepage": "https://github.com/[eshlon/onenote-mcp-server#readme",
  "dependencies": {
    "@azure/identity": "^4.1.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@modelcontextprotocol/sdk": "^1.7.0",
    "@napi-rs/keyring": "^1.2.0",
    "jsdom": "^24.0.0",
    "node-fetch": "^3.3.2",
    "pino": "^10.1.0",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^61.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.6.2"
  },
  "lint-staged": {
    "*.{js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
